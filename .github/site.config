# 3D MicroViewer (microviewer/) reads stacks in the browser and needs nothing else from the repo;
# the root index.html forwards to it.
publish_root=.
publish_paths=index.html microviewer
# writes microviewer/config.js: the Drive folder from data/sources.json, and the Google API key
# when the repository has a GOOGLE_API_KEY variable (optional, so it is not a build_var)
build_command=node microviewer/build.mjs
